# Google AI Studio key (free tier). Free-tier inputs may be used to improve Google products: fictional data only.
GEMINI_API_KEY=
# Groq key (free tier, OpenAI-compatible endpoint). Free tier is 8,000 tokens per minute per model,
# so Groq is a best-effort fallback: one Kilta model call is roughly 5,000 tokens.
GROQ_API_KEY=
# Model chain, in order: primary Gemini -> Groq -> Gemini Flash-Lite -> local Ollama.
# Pinned IDs on purpose: on 2026-10-21 the gemini-flash-latest alias timed out under load, and
# gemini-2.5-* returned 404 for new keys.
KILTA_MODEL_PRIMARY=gemini-3.5-flash
KILTA_MODEL_GROQ=openai/gpt-oss-120b
KILTA_MODEL_FALLBACK=gemini-3.5-flash-lite
KILTA_OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
# Retry/fallback tuning (seconds). Defaults are fine; raise MIN_INTERVAL to pace calls on free tiers.
# KILTA_MODEL_RETRIES=2
# KILTA_MODEL_RETRY_DELAY=1.0
# KILTA_MODEL_TIMEOUT=20
# KILTA_MODEL_MIN_INTERVAL=0
# KILTA_MODEL_COOLDOWN=45
KILTA_MCP_URL=http://localhost:8765/mcp
# Bridge (the Alexa+ stand-in)
# KILTA_BRIDGE_HOST=127.0.0.1
# KILTA_BRIDGE_PORT=8000
# Share the server's data folder so POST /api/reset can restore the demo data (default: ./data)
# KILTA_DATA_DIR=
KILTA_DEMO_MODE=true
